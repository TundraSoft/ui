# The @jsr scope resolves from JSR's npm-compat registry so @tundralibs/*
# install under Node (npm) without a global config. Registry only, no tokens.
@jsr:registry=https://npm.jsr.io
# package.json names the JSR packages by their real names, as aliases
# ("@tundralibs/rapid": "npm:@jsr/tundralibs__rapid@…"). npm 12 refuses a
# tarball whose host is not the registry of the dependency's *own* scope
# (EALLOWREMOTE), and for an alias that is @tundralibs, so that scope points
# at JSR too. Nothing here installs a real npm @tundralibs/* package.
@tundralibs:registry=https://npm.jsr.io
