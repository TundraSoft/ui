{
  "name": "@tundralibs/ui",
  "version": "0.3.0",
  "license": "MIT",
  "exports": {
    "./alert": "./components/alert/alert.ts",
    "./assets": "./assets.ts",
    "./avatar": "./components/avatar/avatar.ts",
    "./badge": "./components/badge/badge.ts",
    "./breadcrumb": "./components/breadcrumb/breadcrumb.ts",
    "./button": "./components/button/button.ts",
    "./card": "./components/card/card.ts",
    "./chart": "./components/chart/chart.ts",
    "./choice": "./components/choice/choice.ts",
    "./collapsible": "./components/collapsible/collapsible.ts",
    "./combobox": "./components/combobox/combobox.ts",
    "./command": "./components/command/command.ts",
    "./data-table": "./components/data-table/data-table.ts",
    "./datepicker": "./components/datepicker/datepicker.ts",
    "./dropdown": "./components/dropdown/dropdown.ts",
    "./dropzone": "./components/dropzone/dropzone.ts",
    "./editor": "./components/editor/editor.ts",
    "./empty": "./components/empty/empty.ts",
    "./form": "./components/form/form.ts",
    "./form-field": "./components/form-field/form-field.ts",
    "./grid": "./components/grid/grid.ts",
    "./input": "./components/input/input.ts",
    "./layouts": "./layouts/mod.ts",
    "./layouts/article": "./layouts/article/article.ts",
    "./layouts/auth": "./layouts/auth/auth.ts",
    "./layouts/docs": "./layouts/docs/docs.ts",
    "./layouts/focus": "./layouts/focus/focus.ts",
    "./layouts/rail": "./layouts/rail/rail.ts",
    "./layouts/sidebar": "./layouts/sidebar/sidebar.ts",
    "./layouts/split": "./layouts/split/split.ts",
    "./layouts/stacked": "./layouts/stacked/stacked.ts",
    "./menu": "./components/menu/menu.ts",
    "./modal": "./components/modal/modal.ts",
    "./navbar": "./components/navbar/navbar.ts",
    "./otp": "./components/otp/otp.ts",
    "./page-header": "./components/page-header/page-header.ts",
    "./pagination": "./components/pagination/pagination.ts",
    "./popover": "./components/popover/popover.ts",
    "./progress": "./components/progress/progress.ts",
    "./segmented": "./components/segmented/segmented.ts",
    "./select": "./components/select/select.ts",
    "./shared/attrs": "./shared/attrs.ts",
    "./shared/classnames": "./shared/classnames.ts",
    "./shared/icons": "./shared/icons.ts",
    "./sidebar": "./components/sidebar/sidebar.ts",
    "./skeleton": "./components/skeleton/skeleton.ts",
    "./slider": "./components/slider/slider.ts",
    "./stat": "./components/stat/stat.ts",
    "./switch": "./components/switch/switch.ts",
    "./tabs": "./components/tabs/tabs.ts",
    "./templates/core": "./templates/core.ts",
    "./templates/errors": "./templates/errors.ts",
    "./templates/layout": "./templates/layout.ts",
    "./textarea": "./components/textarea/textarea.ts",
    "./timeline": "./components/timeline/timeline.ts",
    "./toast": "./components/toast/toast.ts",
    "./toolbar": "./components/toolbar/toolbar.ts",
    "./tooltip": "./components/tooltip/tooltip.ts",
    "./version": "./version.ts",
    "./wizard": "./components/wizard/wizard.ts"
  },
  "imports": {
    "@tundralibs/rapid/ui": "jsr:@tundralibs/rapid@^0.5.0/ui",
    "@tundralibs/compat/file": "jsr:@tundralibs/compat@^2.7.2/file",
    "@tundralibs/compat/runtime": "jsr:@tundralibs/compat@^2.7.2/runtime",
    "@tundralibs/compat/webserver": "jsr:@tundralibs/compat@^2.7.2/webserver",
    "postcss": "npm:postcss@^8.5.0",
    "postcss-import": "npm:postcss-import@^16.1.0",
    "postcss-mixins": "npm:postcss-mixins@^11.0.0",
    "postcss-nesting": "npm:postcss-nesting@^13.0.0",
    "puppeteer-core": "npm:puppeteer-core@^25.11.0",
    "@tundralibs/rapid": "jsr:@tundralibs/rapid@^0.5.0",
    "@tundralibs/compat/path": "jsr:@tundralibs/compat@^2.7.2/path",
    "esbuild": "npm:esbuild@0.25.12"
  },
  "publish": {
    "include": [
      "components/",
      "layouts/",
      "shared/",
      "styles/",
      "tokens/",
      "templates/",
      "dist/",
      "assets.ts",
      "version.ts",
      "deno.json",
      "README.md",
      "LICENSE"
    ],
    "exclude": [
      "examples/",
      "demo/",
      "scripts/",
      ".test-output/",
      "**/*.js.map",
      "package.json",
      "bunfig.toml",
      ".npmrc",
      "*.lock",
      "package-lock.json"
    ]
  },
  "tasks": {
    "build:css": "deno run -A scripts/build-css.ts",
    "build:js": "deno run -A scripts/build-js.ts",
    "build": "deno task build:css && deno task build:js && deno task build:icons && deno task build:manifest",
    "build:admin-theme": "deno run -A examples/pages/build-admin-theme.ts",
    "build:demos": "deno task build:admin-theme && deno task build:layouts && deno task build:catalogue",
    "test:admin": "deno run -A examples/tests/test-admin.ts",
    "test:all": "deno run -A examples/tests/test-all-pages.ts",
    "test": "deno task build && deno task build:demos && deno task test:contract && deno task test:catalogue && deno task test:layouts && deno task test:all && deno task test:admin && deno task test:app",
    "perf": "deno run -A examples/tests/perf-audit.ts",
    "build:layouts": "deno run -A examples/pages/build-layouts.ts",
    "test:layouts": "deno run -A examples/tests/test-layouts.ts",
    "build:manifest": "deno run -A scripts/build-manifest.ts",
    "check": "deno check components/ layouts/ shared/ templates/ assets.ts version.ts examples/ scripts/",
    "lint": "deno lint",
    "fmt": "deno fmt",
    "fmt:check": "deno fmt --check",
    "app": "deno run -A examples/app/serve.ts",
    "test:app": "deno run -A examples/tests/test-app.ts",
    "build:catalogue": "deno run -A examples/pages/build-catalogue.ts",
    "test:contract": "deno run -A examples/tests/test-contract.ts",
    "test:catalogue": "deno run -A examples/tests/test-catalogue.ts",
    "docs:api": "deno doc --json components/*/*.ts layouts/*/*.ts templates/*.ts shared/attrs.ts shared/classnames.ts shared/icons.ts assets.ts version.ts > .docs-api.json",
    "docs": "deno task docs:api && deno run -A scripts/build-docs.ts",
    "build:icons": "deno run -A scripts/build-icons.ts"
  },
  "fmt": {
    "lineWidth": 120,
    "exclude": [
      "demo/",
      "dist/",
      "_archive/",
      "node_modules/",
      ".test-output/",
      "version.ts",
      "docs/reference/",
      "docs/Reference.md",
      "CHANGELOG.md"
    ]
  },
  "lint": {
    "exclude": [
      "demo/",
      "dist/",
      "_archive/",
      "node_modules/",
      ".test-output/"
    ]
  },
  "nodeModulesDir": "none",
  "minimumDependencyAge": {
    "age": "P1D",
    "exclude": [
      "jsr:@tundralibs/ambient",
      "npm:@jsr/tundralibs__ambient",
      "jsr:@tundralibs/cacher",
      "npm:@jsr/tundralibs__cacher",
      "jsr:@tundralibs/compat",
      "npm:@jsr/tundralibs__compat",
      "jsr:@tundralibs/cronus",
      "npm:@jsr/tundralibs__cronus",
      "jsr:@tundralibs/crypt",
      "npm:@jsr/tundralibs__crypt",
      "jsr:@tundralibs/doctor",
      "npm:@jsr/tundralibs__doctor",
      "jsr:@tundralibs/drivers",
      "npm:@jsr/tundralibs__drivers",
      "jsr:@tundralibs/guardian",
      "npm:@jsr/tundralibs__guardian",
      "jsr:@tundralibs/id",
      "npm:@jsr/tundralibs__id",
      "jsr:@tundralibs/metro-man",
      "npm:@jsr/tundralibs__metro-man",
      "jsr:@tundralibs/norm",
      "npm:@jsr/tundralibs__norm",
      "jsr:@tundralibs/oql",
      "npm:@jsr/tundralibs__oql",
      "jsr:@tundralibs/pact",
      "npm:@jsr/tundralibs__pact",
      "jsr:@tundralibs/radrouter",
      "npm:@jsr/tundralibs__radrouter",
      "jsr:@tundralibs/rapid",
      "npm:@jsr/tundralibs__rapid",
      "jsr:@tundralibs/restler",
      "npm:@jsr/tundralibs__restler",
      "jsr:@tundralibs/rpc",
      "npm:@jsr/tundralibs__rpc",
      "jsr:@tundralibs/slogger",
      "npm:@jsr/tundralibs__slogger",
      "jsr:@tundralibs/tracer",
      "npm:@jsr/tundralibs__tracer",
      "jsr:@tundralibs/ui",
      "npm:@jsr/tundralibs__ui",
      "jsr:@tundralibs/utils",
      "npm:@jsr/tundralibs__utils"
    ]
  }
}
